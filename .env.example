ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LOG_LEVEL=INFO

# Uni API gateway used by the Qwen/Minimax definitions in agents.yaml.
CSTCLOUD_API_KEY=
# Set a persistent random secret before saving API keys through the Web UI.
DOUDIZHU_CREDENTIAL_MASTER_KEY=

# Docker Compose host ports and persistent directories (relative to this repo).
# DOUDIZHU_FRONTEND_PORT=80
# DOUDIZHU_BACKEND_PORT=8000
# DOUDIZHU_DATA_DIR=./data
# DOUDIZHU_LOG_DIR=./src/backend/logs

# Local backend only: relative paths are resolved from the project root.
# Compose uses fixed /app paths and the host mounts above.
# DATABASE_URL=sqlite:///data/arena.db
# LOG_DIR=src/backend/logs
# AGENTS_YAML_PATH=src/backend/arena/config/agents.yaml
